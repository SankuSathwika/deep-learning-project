},"source":["import torch\n","import torch.nn as nn\n","import torch.optim as optim\n","from torch.utils.data import DataLoader, TensorDataset\n","\n","# Set random seeds for reproducibility\n","torch.manual_seed(42)\n","np.random.seed(42)\n","\n","# 1. Convert Pandas DataFrames to PyTorch Tensors\n","X_train_tensor = torch.tensor(X_train_scaled.values, dtype=torch.float32)\n","y_train_tensor = torch.tensor(y_train.values, dtype=torch.long)\n","\n","X_val_tensor = torch.tensor(X_val_scaled.values, dtype=torch.float32)\n","y_val_tensor = torch.tensor(y_val.values, dtype=torch.long)\n","\n","X_test_tensor = torch.tensor(X_test_scaled.values, dtype=torch.float32)\n","y_test_tensor = torch.tensor(y_test.values, dtype=torch.long)\n","\n","# Create PyTorch datasets and DataLoaders\n","train_dataset = TensorDataset(X_train_tensor, y_train_tensor)\n","val_dataset = TensorDataset(X_val_tensor, y_val_tensor)\n","test_dataset = TensorDataset(X_test_tensor, y_test_tensor)\n","\n","train_loader = DataLoader(train_dataset, batch_size=32, shuffle=True)\n","val_loader = DataLoader(val_dataset, batch_size=32, shuffle=False)\n","test_loader = DataLoader(test_dataset, batch_size=32, shuffle=False)\n","\n","# 2. Define the ANN Architecture\n","class SimpleANN(nn.Module):\n","    def __init__(self, input_dim, output_dim):\n","        super(SimpleANN, self).__init__()\n","        self.network = nn.Sequential(\n","            nn.Linear(input_dim, 64),\n","            nn.ReLU(),\n","            nn.Dropout(p=0.3),\n","            nn.Linear(64, output_dim)\n","        )\n","\n","    def forward(self, x):\n","        return self.network(x)\n","\n","# Initialize model, loss function, and optimizer\n","input_dim = X_train_tensor.shape[1]\n","output_dim = len(torch.unique(y_train_tensor))\n","\n","ann_model = SimpleANN(input_dim, output_dim)\n","criterion = nn.CrossEntropyLoss()\n","optimizer = optim.Adam(ann_model.parameters(), lr=0.005)\n","\n","# 3. Training Loop with early stopping variables\n","epochs = 60\n","ann_train_losses = []\n","ann_val_losses = []\n","\n","for epoch in range(1, epochs + 1):\n","    ann_model.train()\n","    running_loss = 0.0\n","    for inputs, targets in train_loader:\n","        optimizer.zero_grad()\n","        outputs = ann_model(inputs)\n","        loss = criterion(outputs, targets)\n","        loss.backward()\n","        optimizer.step()\n","        running_loss += loss.item() * inputs.size(0)\n","\n","    epoch_train_loss = running_loss / len(train_loader.dataset)\n","    ann_train_losses.append(epoch_train_loss)\n","\n","    # Validation\n","    ann_model.eval()\n","    val_loss = 0.0\n","    with torch.no_grad():\n","        for inputs, targets in val_loader:\n","            outputs = ann_model(inputs)\n","            loss = criterion(outputs, targets)\n","            val_loss += loss.item() * inputs.size(0)\n","\n","    epoch_val_loss = val_loss / len(val_loader.dataset)\n","    ann_val_losses.append(epoch_val_loss)\n","\n","    if epoch % 10 == 0 or epoch == 1:\n","        print(f\"Epoch {epoch:02d}/{epochs} | Train Loss: {epoch_train_loss:.4f} | Val Loss: {epoch_val_loss:.4f}\")\n","\n","# 4. Plot Training & Validation Curves\n","plt.figure(figsize=(8, 4))\n","plt.plot(range(1, epochs + 1), ann_train_losses, label='Train Loss', color='blue')\n","plt.plot(range(1, epochs + 1), ann_val_losses, label='Val Loss', color='orange')\n","plt.title('ANN Training & Validation Loss')\n","plt.xlabel('Epochs')\n","plt.ylabel('Loss')\n","plt.legend()\n","plt.grid(True)\n","plt.show()"],"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["Epoch 01/60 | Train Loss: 1.1636 | Val Loss: 0.9873\n","Epoch 10/60 | Train Loss: 0.7676 | Val Loss: 0.8611\n","Epoch 20/60 | Train Loss: 0.7065 | Val Loss: 0.8631\n","Epoch 30/60 | Train Loss: 0.6653 | Val Loss: 0.8810\n","Epoch 40/60 | Train Loss: 0.6553 | Val Loss: 0.8857\n","Epoch 50/60 | Train Loss: 0.6484 | Val Loss: 0.8874\n","Epoch 60/60 | Train Loss: 0.6302 | 