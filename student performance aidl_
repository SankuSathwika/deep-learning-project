ta import DataLoader, TensorDataset\n","from sklearn.model_selection import train_test_split\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.metrics import accuracy_score, precision_recall_fscore_support, classification_report\n","from pytorch_tabnet.tab_model import TabNetClassifier\n","\n","# Set random seeds for reproducibility\n","torch.manual_seed(42)\n","np.random.seed(42)\n","\n","# 1. Load Dataset\n","dataset_path = 'Student_performance_data _.csv'\n","df = pd.read_csv(dataset_path)\n","\n","# 2. Features and Target Preparation\n","X = df.drop(columns=['StudentID', 'GPA', 'GradeClass'])\n","y = df['GradeClass'].astype(int)\n","\n","# 3. Splits (70% Train, 15% Val, 15% Test)\n","X_train_val, X_test, y_train_val, y_test = train_test_split(\n","    X, y, test_size=0.15, random_state=42, stratify=y\n",")\n","\n","X_train, X_val, y_train, y_val = train_test_split(\n","    X_train_val, y_train_val, test_size=0.1765, random_state=42, stratify=y_train_val\n",")\n","\n","# 4. Feature Scaling\n","numerical_cols = ['Age', 'StudyTimeWeekly', 'Absences']\n","scaler = StandardScaler()\n","X_train_scaled = X_train.copy()\n","X_val_scaled = X_val.copy()\n","X_test_scaled = X_test.copy()\n","\n","X_train_scaled[numerical_cols] = scaler.fit_transform(X_train[numerical_cols])\n","X_val_scaled[numerical_cols] = scaler.transform(X_val[numerical_cols])\n","X_test_scaled[numerical_cols] = scaler.transform(X_test[numerical_cols])\n","\n","# Convert to NumPy for TabNet and PyTorch Tensors\n","X_train_np, y_train_np = X_train_scaled.values, y_train.values\n","X_val_np, y_val_np = X_val_scaled.values, y_val.values\n","X_test_np, y_test_np = X_test_scaled.values, y_test.values\n","\n","X_train_tensor = torch.tensor(X_train_np, dtype=torch.float32)\n","y_train_tensor = torch.tensor(y_train_np, dtype=torch.long)\n","X_val_tensor = torch.tensor(X_val_np, dtype=torch.float32)\n","y_val_tensor = torch.tensor(y_val_np, dtype=torch.long)\n","X_test_tensor = torch.tensor(X_test_np, dtype=torch.float32)\n","y_test_tensor = torch.tensor(y_test_np, dtype=torch.long)\n","\n","train_dataset = TensorDataset(X_train_tensor, y_train_tensor)\n","train_loader = DataLoader(train_dataset, batch_size=32, shuffle=True)\n","\n","# 5. Build and Train ANN Model\n","class SimpleANN(nn.Module):\n","    def __init__(self, input_dim, output_dim):\n","        super(SimpleANN, self).__init__()\n","        self.network = nn.Sequential(\n","            nn.Linear(input_dim, 64),\n","            nn.ReLU(),\n","            nn.Dropout(p=0.3),\n","            nn.Linear(64, output_dim)\n","        )\n","    def forward(self, x): return self.network(x)\n","\n","ann_model = SimpleANN(X_train_tensor.shape[1], len(np.unique(y_train_np)))\n","ann_optimizer = optim.Adam(ann_model.parameters(), lr=0.005)\n","criterion = nn.CrossEntropyLoss()\n","\n","for epoch in range(60):\n","    ann_model.train()\n","    for inputs, targets in train_loader:\n","        ann_optimizer.zero_grad()\n","        loss = criterion(ann_model(inputs), targets)\n","        loss.backward()\n","        ann_optimizer.step()\n","\n","# 6. Build and Train DNN Model\n","class DeepDNN(nn.Module):\n","    def __init__(self, input_dim, output_dim):\n","        super(DeepDNN, self).__init__()\n","        self.network = nn.Sequential(\n","            nn.Linear(input_dim, 128),\n","            nn.BatchNorm1d(128),\n","            nn.ReLU(),\n","            nn.Dropout(p=0.4),\n","            nn.Linear(128, 64),\n","            nn.BatchNorm1d(64),\n","            nn.ReLU(),\n","            nn.Dropout(p=0.3),\n","            nn.Linear(64, output_dim)\n","        )\n","    def forward(self, x): return self.network(x)\n","\n","dnn_model = DeepDNN(X_train_tensor.shape[1], len(np.unique(y_train_np)))\n","dnn_optimizer = optim.Adam(dnn_model.parameters(), lr=0.005)\n","\n","for epoch in range(60):\n","    dnn_model.train()\n","    for inputs, targets in train_loader:\n","        dnn_optimizer.zero_grad()\n","        loss = criterion(dnn_model(inputs), targets)\n","        loss.backward()\n","        dnn_optimizer.step()\n","\n","# 7. Train TabNet Model\n","tabnet_model = TabNetClassifier(\n","    n_d=16, n_a=16, n_steps=3, gamma=1.3,\n","    optimizer_fn=torch.optim.Adam, optimizer_params=dict(lr=2e-2),\n","    scheduler_params=dict(step_size=10, gamma=0.5),\n","    scheduler_fn=torch.optim.lr_scheduler.StepLR,\n","    mask_type='sparsemax', verbose=0\n",")\n","tabnet_model.fit(\n","    X_train=X_train_np, y_train=y_train_np,\n","    eval_set=[(X_val_np, y_val_np)], eval_name=['val'],\n","    eval_metric=['accuracy'], max_epochs=80, patience=15, batch_size=64\n",")\n","\n","# 8. Evaluation\n","ann_model.eval()\n","with torch.no_grad():\n","    _, ann_preds = torch.max(ann_model(X_test_tensor), 1)\n","ann_preds = ann_preds.numpy()\n","\n","dnn_model.eval()\n","with torch.no_grad():\n","    _, dnn_preds = torch.max(dnn_model(X_test_tensor), 1)\n","dnn_preds = dnn_preds.numpy()\n","\n","tabnet_preds = tabnet_model.predict(X_test_np)\n","\n","def calculate_metrics(y_true, y_pred, model_name):\n","    acc = accuracy_score(y_true, y_pred)\n","    prec, rec, f1, _ = precision_recall_fscore_support(y_true, y_pred, average='weighted', zero_division=0)\n","    return {'Model': model_name, 'Accuracy': acc, 'Precision': prec, 'Recall': rec, 'F1-score': f1}\n","\n","results_df = pd.DataFrame([\n","    calculate_metrics(y_test_np, ann_preds, 'ANN'),\n","    calculate_metrics(y_test_np, dnn_preds, 'DNN'),\n","    calculate_metrics(y_test_np, tabnet_preds, 'TabNet')\n","])\n","\n","print(\"=== Performance Metrics Summary ===\")\n","display(results_df)\n","\n","print(\"\\n=== ANN Classification Report ===\")\n","print(classification_report(y_test_np, ann_preds, zero_division=0))\n","\n","print(\"\\n=== DNN Classification Report ===\")\n","print(classification_report(y_test_np, dnn_preds, zero_division=0))\n","\n","print(\"\\n=== TabNet Classification Report ===\")\n","print(classification_report(y_test_np, tabnet_preds, zero_division=0))"],"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Early stopping occurred at epoch 42 with best_epoch = 27 and best_val_accuracy = 0.74095\n","=== Performance Metrics Summary ===\n"]},{"output_type":"stream","name":"stderr","text":["/usr/local/lib/python3.13/dist-packages/pytorch_tabnet/callbacks.py:172: UserWarning: Best weights from best epoch are automatically used!\n","  warnings.warn(wrn_msg)\n"]},{"output_type":"display_data","data":{"text/plain":["    Model  Accuracy  Precision    Recall  F1-score\n","0     ANN  0.713092   0.708485  0.713092  0.706717\n","1     DNN  0.721448   0.724867  0.721448  0.716410\n","2  TabNet  0.740947   0.733224  0.740947  0.732272"],"text/html":["\n","  <div id=\"df-d7a54dd0-2f86-4bb1-9d71-e2c22352dedc\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>Model</th>\n","      <th>Accuracy</th>\n","      <th>Precision</th>\n","      <th>Recall</th>\n","      <th>F1-score</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>ANN</td>\n","      <td>0.713092</td>\n","      <td>0.708485</td>\n","      <td>0.713092</td>\n","      <td>0.706717</td>\n","    </tr>\n","    <tr>\n","      <th>1</th>\n","      <td>DNN</td>\n","      <td>0.721448</td>\n","      <td>0.724867</td>\n","      <td>0.721448</td>\n","      <td>0.716410</td>\n","    </tr>\n","    <tr>\n","      <th>2</th>\n","      <td>TabNet</td>\n","      <td>0.740947</td>\n","      <td>0.733224</td>\n","      <td>0.740947</td>\n","      <td>0.732272</td>\n"